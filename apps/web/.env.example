# Payload-CMS (lokal: pnpm dev in apps/cms)
CMS_URL=http://localhost:3000
# Öffentliche Basis-URL der Website (Canonical, hreflang, Sitemap)
SITE_URL=http://localhost:4321
# Optional: Medien direkt ausliefern (Caddy: /media). Leer = über die CMS-API.
MEDIA_URL=
# Vorschau (SSR-Route /preview) – gleicher Wert wie im CMS
PREVIEW_SECRET=
# API-Key eines Dienstkontos mit Leserechten (für Entwürfe in der Vorschau)
CMS_API_KEY=
