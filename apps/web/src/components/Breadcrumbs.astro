---
import { t, type LocaleCode } from '@/i18n'

type Crumb = { href?: string; label: string }
type Props = { locale: LocaleCode; items: Crumb[] }
const { locale, items } = Astro.props
const ui = t(locale)
---

{
  items.length > 1 && (
    <nav aria-label={ui.breadcrumb} class="container-page pt-6 text-sm">
      <ol class="flex flex-wrap gap-x-2 gap-y-1">
        {items.map((item, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" class="text-muted">/</span>}
            {i === items.length - 1 || !item.href ? (
              <span aria-current={i === items.length - 1 ? 'page' : undefined}>{item.label}</span>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
