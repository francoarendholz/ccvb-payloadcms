---
import type { Document } from '@ccvb/shared/payload-types'

import { formatDate, isoDay, t, type LocaleCode } from '@/i18n'
import { documentMeta, documentUrl } from '@/lib/media'

type Props = { docs: Document[]; locale: LocaleCode; class?: string }
const { docs, locale, class: className } = Astro.props
const ui = t(locale)
---

{
  docs.length === 0 ? (
    <p>{ui.noDocuments}</p>
  ) : (
    <ul class:list={['divide-y divide-line border-y border-line', className]}>
      {docs.map((doc) => {
        const meta = documentMeta(doc, locale)
        return (
          <li class="flex items-start gap-3 py-3" data-area={doc.area ?? ''} data-category={typeof doc.category === 'object' ? doc.category?.slug : ''}>
            <svg aria-hidden="true" class="mt-1 shrink-0 text-brand" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 13l-4-4h2.5V3h3v6H14l-4 4zM4 15h12v2H4z" />
            </svg>
            <div>
              <a href={documentUrl(doc)} download={doc.filename ?? true} class="font-semibold">
                {doc.title}
                <span class="font-normal text-muted"> ({meta})</span>
              </a>
              {doc.description && <p class="text-sm">{doc.description}</p>}
              {doc.validFrom && (
                <p class="text-sm text-muted">
                  {ui.validFrom}: <time datetime={isoDay(doc.validFrom)}>{formatDate(locale, doc.validFrom)}</time>
                </p>
              )}
            </div>
          </li>
        )
      })}
    </ul>
  )
}
