---
/**
 * Rendert Lexical-JSON aus Payload zu semantischem HTML. Bewusst eigener, kleiner Renderer:
 * Der Editor erlaubt nur Absätze, H2–H4, Listen, Links, fett/kursiv und wenige eingebettete
 * Blöcke – so bleibt die volle Kontrolle über Barrierefreiheit (Linktexte, externe Links).
 */
import type { LocaleCode } from '@/i18n'
import { resolveLink } from '@/lib/links'
import ExtLink from './ExtLink.astro'
import InlineBlock from './blocks/InlineBlock.astro'

type Node = {
  type: string
  children?: Node[]
  text?: string
  format?: number | string
  tag?: string
  listType?: string
  fields?: Record<string, any>
  [key: string]: unknown
}

type Props = {
  locale: LocaleCode
  /** Lexical-Dokument (`{ root }`) oder Liste von Knoten (rekursiv). */
  data?: { root: Node } | null
  nodes?: Node[]
  class?: string
}

const { locale, data, nodes: childNodes, class: className } = Astro.props
const nodes: Node[] = childNodes ?? data?.root?.children ?? []
const isRoot = !childNodes

const BOLD = 1
const ITALIC = 2
const STRIKE = 4
const SUB = 32
const SUP = 64

const hasContent = (node: Node): boolean =>
  node.type !== 'paragraph' || Boolean(node.children?.some((c) => c.type !== 'text' || c.text?.trim()))

const linkOf = (node: Node) => {
  const f = node.fields ?? {}
  if (node.type === 'autolink' || f.linkType !== 'internal') {
    return resolveLink(locale, { type: 'custom', url: f.url, newTab: f.newTab, label: '-' })
  }
  return resolveLink(locale, { type: 'reference', reference: f.doc, newTab: f.newTab, label: '-' })
}
---

{
  isRoot ? (
    nodes.length > 0 && (
      <div class:list={['prose', className]}>
        <Astro.self locale={locale} nodes={nodes.filter(hasContent)} />
      </div>
    )
  ) : (
    nodes.map((node) => {
      switch (node.type) {
        case 'text': {
          const f = typeof node.format === 'number' ? node.format : 0
          let out: any = node.text
          if (f & BOLD) out = <strong>{out}</strong>
          if (f & ITALIC) out = <em>{out}</em>
          if (f & STRIKE) out = <s>{out}</s>
          if (f & SUB) out = <sub>{out}</sub>
          if (f & SUP) out = <sup>{out}</sup>
          return out
        }
        case 'linebreak':
          return <br />
        case 'tab':
          return ' '
        case 'paragraph':
          return (
            <p>
              <Astro.self locale={locale} nodes={node.children ?? []} />
            </p>
          )
        case 'heading': {
          const Tag = (['h2', 'h3', 'h4'].includes(node.tag ?? '') ? node.tag : 'h2') as 'h2'
          return (
            <Tag>
              <Astro.self locale={locale} nodes={node.children ?? []} />
            </Tag>
          )
        }
        case 'list': {
          const Tag = node.listType === 'number' ? 'ol' : 'ul'
          return (
            <Tag>
              <Astro.self locale={locale} nodes={node.children ?? []} />
            </Tag>
          )
        }
        case 'listitem': {
          // Verschachtelte Liste: Lexical legt sie als eigenes listitem ab.
          const nestedOnly = node.children?.length === 1 && node.children[0].type === 'list'
          return nestedOnly ? (
            <li class="list-none">
              <Astro.self locale={locale} nodes={node.children ?? []} />
            </li>
          ) : (
            <li>
              <Astro.self locale={locale} nodes={node.children ?? []} />
            </li>
          )
        }
        case 'link':
        case 'autolink': {
          const link = linkOf(node)
          if (!link) return <Astro.self locale={locale} nodes={node.children ?? []} />
          return (
            <ExtLink href={link.href} newTab={link.newTab} locale={locale}>
              <Astro.self locale={locale} nodes={node.children ?? []} />
            </ExtLink>
          )
        }
        case 'block':
          return node.fields ? <InlineBlock block={node.fields as any} locale={locale} /> : null
        default:
          return node.children ? <Astro.self locale={locale} nodes={node.children} /> : null
      }
    })
  )
}
