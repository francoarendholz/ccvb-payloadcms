---
import type { Category, Post } from '@ccvb/shared/payload-types'

import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Picture from '@/components/Picture.astro'
import RichText from '@/components/RichText.astro'
import { AREA_LABELS, formatDate, isoDay, localePath, sectionPath, t, type LocaleCode } from '@/i18n'
import { resolved } from '@/lib/cms'

type Props = { doc: Post; locale: LocaleCode }
const { doc, locale } = Astro.props
const ui = t(locale)
const categories = (doc.categories ?? []).map((c) => resolved<Category>(c)).filter((c) => c?.title)
const image = resolved(doc.heroImage)
---

<Breadcrumbs
  locale={locale}
  items={[
    { href: localePath(locale), label: ui.home },
    { href: sectionPath(locale, 'posts'), label: ui.posts },
    { label: doc.title },
  ]}
/>

<article class="container-page pt-8">
  <header class="max-w-(--container-content)">
    <h1 class="text-3xl leading-tight font-bold md:text-5xl">{doc.title}</h1>
    <p class="mt-3 text-muted">
      {doc.publishedAt && <>{ui.published} <time datetime={isoDay(doc.publishedAt)}>{formatDate(locale, doc.publishedAt)}</time></>}
      {doc.area && <> · {AREA_LABELS[locale][doc.area]}</>}
      {categories.length > 0 && <> · {categories.map((c) => c!.title).join(', ')}</>}
    </p>
    {doc.excerpt && <p class="mt-4 text-lg md:text-xl">{doc.excerpt}</p>}
  </header>
  {
    image && (
      <figure class="mt-8 max-w-4xl">
        <Picture media={image} loading="eager" sizes="(min-width: 64rem) 56rem, 100vw" class="h-auto w-full rounded" />
        {image.credit && <figcaption class="mt-2 text-sm text-muted">{ui.imageCredit}: {image.credit}</figcaption>}
      </figure>
    )
  }
  <RichText data={doc.content as any} locale={locale} class="mt-8" />
  <p class="mt-12"><a href={sectionPath(locale, 'posts')} class="font-semibold">{ui.allPosts}</a></p>
</article>
