  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@ccvb/shared": "workspace:*",
    "@fontsource-variable/roboto": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "pagefind": "1.5.2",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "typescript": "5.7.3"
  }
}
